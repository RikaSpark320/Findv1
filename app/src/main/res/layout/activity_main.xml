<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="top|center_horizontal"
    android:background="#B5B5B5">

    <ImageView
        android:layout_width="256dp"
        android:layout_height="227dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/logo2" />

    <Button
        android:id="@+id/btnFichas"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:cornerRadius="24dp"
        android:text="Fichas de Búsqueda"
        android:textSize="16sp"
        android:backgroundTint="#85C1E9"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnReportes"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:cornerRadius="24dp"
        android:text="Reporte de Avistamiento"
        android:textSize="16sp"
        android:backgroundTint="#76D7C4"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnEmergencia"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:cornerRadius="24dp"
        android:text="Botón de Pánico (911)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#E74C3C"
        android:textColor="#FFFFFF" />

</LinearLayout>